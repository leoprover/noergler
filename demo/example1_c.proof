% SZS output start Proof
fof(p1, axiom, p(a) & ~p(b), file('example1_c.p',a1)).
fof(p2, conjecture, ?[X] : ~(p(X) => ![Y] : (p(Y))), file('example1_c.p',c)).
fof(p3, negated_conjecture, ![X] : (p(X) => ![Y] : (p(Y))), inference(negated_conjecture, [status(cth)], [p2])).
fof(p4, plain, $false, inference(consequence, [status(thm)], [p3, p1])).
% SZS output end Proof
